    {
      "cell_type": "code",
      "source": [
        "from sklearn.ensemble import RandomForestClassifier\n",
        "import pandas as pd\n",
        "\n",
        "# Example data collection\n",
        "data = []\n",
        "\n",
        "for img_file in os.listdir(face_images_path):\n",
        "    full_path = os.path.join(face_images_path, img_file)\n",
        "\n",
        "    if os.path.isdir(full_path):\n",
        "        # Silently skip .ipynb_checkpoints as it's a system directory\n",
        "        if img_file == '.ipynb_checkpoints':\n",
        "            continue\n",
        "        else:\n",
        "            print(f\"Skipping directory: {img_file}.\")\n",
        "            continue\n",
        "\n",
        "    # Check if it's an image file by extension\n",
        "    if not img_file.lower().endswith(('.png', '.jpg', '.jpeg')):\n",
        "        print(f\"Skipping {img_file}: Not a recognized image file type.\")\n",
        "        continue\n",
        "\n",
        "    img_path = full_path\n",
        "\n",
        "    # Facial features\n",
        "    features = extract_face_features(img_path)  # your FaceMesh code\n",
        "    if features is None:\n",
        "        print(f\"Skipping {img_file}: Could not extract facial features or no face detected.\")\n",
        "        continue\n",
        "\n",
        "    nose_width = features['nose_width']\n",
        "    nose_height = features['nose_height']\n",
        "    eye_openness = features['eye_openness']\n",
        "    nostril_change = features['nostril_change']\n",
        "\n",
        "    # Lung condition\n",
        "    # NOTE: The predict_lung_condition expects an X-ray image path. Here, it is being called with\n",
        "    # a face image path (img_path). This is a logical inconsistency that may lead to incorrect\n",
        "    # lung condition predictions if not properly aligned with corresponding X-ray images.\n",
        "    # In a real-world scenario, you would need a separate mechanism to link face images to X-ray images.\n",
        "    lung = predict_lung_condition(img_path)\n",
        "    lung_encoded = 1 if lung==\"Abnormal\" else 0\n",
        "\n",
        "    # Label (for training you need real labels, here we use dummy)\n",
        "    # In real scenario, labels come from clinical data\n",
        "    label = 1  # 0=Low,1=Medium,2=High\n",
        "\n",
        "    data.append([nose_width, nose_height, eye_openness, nostril_change, lung_encoded, label])\n",
        "\n",
        "df = pd.DataFrame(data, columns=[\"nose_width\",\"nose_height\",\"eye_openness\",\"nostril_change\",\"lung\",\"risk\"])\n",
        "\n",
        "# Train model\n",
        "X = df[[\"nose_width\",\"nose_height\",\"eye_openness\",\"nostril_change\",\"lung\"]]\n",
        "y = df[\"risk\"]\n",
        "\n",
        "rf = RandomForestClassifier(n_estimators=100, random_state=42)\n",
        "rf.fit(X, y)\n",
        "\n",
        "# Predict risk for new image\n",
        "def predict_respiratory_risk_real(features, lung_condition):\n",
        "    lung_encoded = 1 if lung_condition==\"Abnormal\" else 0\n",
        "    # Create a DataFrame for X_test with feature names matching the training data\n",
        "    X_test_data = [[features['nose_width'], features['nose_height'], features['eye_openness'], features['nostril_change'], lung_encoded]]\n",
        "    X_test = pd.DataFrame(X_test_data, columns=[\"nose_width\",\"nose_height\",\"eye_openness\",\"nostril_change\",\"lung\"])\n",
        "    pred = rf.predict(X_test)[0]\n",
        "    mapping = {0:\"Low\",1:\"Medium\",2:\"High\"}\n",
        "    return mapping[pred]"
