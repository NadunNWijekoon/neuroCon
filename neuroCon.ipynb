        "# -------- FaceMesh Init --------\n",
        "mp_face = mp.solutions.face_mesh\n",
        "face_mesh = mp_face.FaceMesh(\n",
        "    static_image_mode=True,\n",
        "    max_num_faces=1,\n",
        "    refine_landmarks=True\n",
        ")\n",
        "\n",
        "def dist(p1, p2):\n",
        "    return np.linalg.norm(np.array(p1) - np.array(p2))\n",
        "\n",
        "def extract_face_features(img_path):\n",
        "    \"\"\"\n",
        "    Extract facial features: nose width/height, eye openness, nostril change\n",
        "    \"\"\"\n",
        "    img = cv2.imread(img_path)\n",
        "    if img is None:\n",
        "        return None  # Could not read image\n",
        "\n",
        "    h, w, _ = img.shape\n",
        "    rgb = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)\n",
        "    results = face_mesh.process(rgb)\n",
        "\n",
        "    if not results.multi_face_landmarks:\n",
        "        return None  # No face detected\n",
        "\n",
        "    face_landmarks = results.multi_face_landmarks[0]\n",
        "\n",
        "    # -------- Landmark Points --------\n",
        "    pts = {}\n",
        "    pts[\"nose_left\"] = (int(face_landmarks.landmark[94].x * w),\n",
        "                        int(face_landmarks.landmark[94].y * h))\n",
        "    pts[\"nose_right\"] = (int(face_landmarks.landmark[331].x * w),\n",
        "                         int(face_landmarks.landmark[331].y * h))\n",
        "    pts[\"nose_top\"] = (int(face_landmarks.landmark[6].x * w),\n",
        "                       int(face_landmarks.landmark[6].y * h))\n",
        "    pts[\"nose_bottom\"] = (int(face_landmarks.landmark[2].x * w),\n",
        "                          int(face_landmarks.landmark[2].y * h))\n",
        "    pts[\"eye_top\"] = (int(face_landmarks.landmark[159].x * w),\n",
        "                      int(face_landmarks.landmark[159].y * h))\n",
        "    pts[\"eye_bottom\"] = (int(face_landmarks.landmark[145].x * w),\n",
        "                         int(face_landmarks.landmark[145].y * h))\n",
        "    pts[\"nostril_left\"] = (int(face_landmarks.landmark[98].x * w),\n",
        "                           int(face_landmarks.landmark[98].y * h))\n",
        "    pts[\"nostril_right\"] = (int(face_landmarks.landmark[327].x * w),\n",
        "                            int(face_landmarks.landmark[327].y * h))\n",
        "\n",
        "    # -------- Measurements --------\n",
        "    nose_width = dist(pts[\"nose_left\"], pts[\"nose_right\"])\n",
        "    nose_height = dist(pts[\"nose_top\"], pts[\"nose_bottom\"])\n",
        "    eye_openness = dist(pts[\"eye_top\"], pts[\"eye_bottom\"])\n",
        "    nostril_change = dist(pts[\"nostril_left\"], pts[\"nostril_right\"])\n",
        "\n",
        "    features = {\n",
        "        \"nose_width\": nose_width,\n",
        "        \"nose_height\": nose_height,\n",
        "        \"eye_openness\": eye_openness,\n",
        "        \"nostril_change\": nostril_change\n",
        "    }\n",
        "    return features\n",
        "\n",
        "def predict_respiratory_risk(nose_width, nose_height, eye_openness, nostril_change):\n",
        "    \"\"\"\n",
        "    Simple heuristic-based prediction for respiratory risk.\n",
        "    You can replace this with a trained ML model for better accuracy.\n",
        "    \"\"\"\n",
        "    # Example simple rules (you can tweak thresholds based on data)\n",
        "    if nose_width > 50 and eye_openness < 20 and nostril_change > 25:\n",
        "        return \"High\"\n",
        "    elif nose_width > 40 or eye_openness < 25 or nostril_change > 20:\n",
        "        return \"Medium\"\n",
        "    else:\n",
        "        return \"Low\"\n",
        "\n",
        "for img_file in os.listdir(face_images_path):\n",
        "    img_path = os.path.join(face_images_path, img_file)\n",
        "    img = cv2.imread(img_path)\n",
        "\n",
        "    if img is None:\n",
        "        continue\n",
        "\n",
        "    h, w, _ = img.shape\n",
        "    rgb = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)\n",
        "    results = face_mesh.process(rgb)\n",
        "\n",
        "    if not results.multi_face_landmarks:\n",
        "        continue\n",
        "\n",
        "    face_landmarks = results.multi_face_landmarks[0]\n",
        "\n",
        "    # -------- Landmark Points --------\n",
        "    pts = {}\n",
        "    pts[\"nose_left\"] = (int(face_landmarks.landmark[94].x * w),\n",
        "                        int(face_landmarks.landmark[94].y * h))\n",
        "    pts[\"nose_right\"] = (int(face_landmarks.landmark[331].x * w),\n",
        "                         int(face_landmarks.landmark[331].y * h))\n",
        "    pts[\"nose_top\"] = (int(face_landmarks.landmark[6].x * w),\n",
        "                       int(face_landmarks.landmark[6].y * h))\n",
        "    pts[\"nose_bottom\"] = (int(face_landmarks.landmark[2].x * w),\n",
        "                          int(face_landmarks.landmark[2].y * h))\n",
        "    pts[\"eye_top\"] = (int(face_landmarks.landmark[159].x * w),\n",
        "                      int(face_landmarks.landmark[159].y * h))\n",
        "    pts[\"eye_bottom\"] = (int(face_landmarks.landmark[145].x * w),\n",
        "                         int(face_landmarks.landmark[145].y * h))\n",
        "    pts[\"nostril_left\"] = (int(face_landmarks.landmark[98].x * w),\n",
        "                           int(face_landmarks.landmark[98].y * h))\n",
        "    pts[\"nostril_right\"] = (int(face_landmarks.landmark[327].x * w),\n",
        "                            int(face_landmarks.landmark[327].y * h))\n",
        "\n",
        "    # -------- Measurements --------\n",
        "    nose_width = dist(pts[\"nose_left\"], pts[\"nose_right\"])\n",
        "    nose_height = dist(pts[\"nose_top\"], pts[\"nose_bottom\"])\n",
        "    eye_openness = dist(pts[\"eye_top\"], pts[\"eye_bottom\"])\n",
        "    nostril_change = dist(pts[\"nostril_left\"], pts[\"nostril_right\"])\n",
        "\n",
        "    # -------- Predict Respiratory Risk --------\n",
        "    risk_level = predict_respiratory_risk(nose_width, nose_height, eye_openness, nostril_change)\n",
        "\n",
        "    # -------- Draw Points --------\n",
        "    for p in pts.values():\n",
        "        cv2.circle(img, p, 3, (0,255,0), -1)\n",
        "\n",
        "    # -------- Draw Measurement Lines --------\n",
        "    cv2.line(img, pts[\"nose_left\"], pts[\"nose_right\"], (255,0,0), 2)\n",
        "    cv2.line(img, pts[\"nose_top\"], pts[\"nose_bottom\"], (0,0,255), 2)\n",
        "    cv2.line(img, pts[\"eye_top\"], pts[\"eye_bottom\"], (255,255,0), 2)\n",
        "    cv2.line(img, pts[\"nostril_left\"], pts[\"nostril_right\"], (0,255,255), 2)\n",
        "\n",
        "    # -------- Display --------\n",
        "    plt.figure(figsize=(6,6))\n",
        "    plt.imshow(cv2.cvtColor(img, cv2.COLOR_BGR2RGB))\n",
        "    plt.title(\n",
        "        f\"{img_file}\\n\"\n",
        "        f\"Nose W: {nose_width:.2f} | \"\n",
        "        f\"Nose H: {nose_height:.2f}\\n\"\n",
        "        f\"Eye Open: {eye_openness:.2f} | \"\n",
        "        f\"Nostril: {nostril_change:.2f}\\n\"\n",
        "        f\"Respiratory Risk: {risk_level}\"\n",
        "    )\n",
        "    plt.axis(\"off\")\n",
        "    plt.show()\n"
